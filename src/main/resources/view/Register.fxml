<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.Text?>

<BorderPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="view.RegisterView">
    <left>
        <AnchorPane prefHeight="200.0" prefWidth="180.0" style="-fx-background-color: #64D96F;" BorderPane.alignment="CENTER">
            <children>
                <ImageView fitHeight="400.0" fitWidth="205.0" pickOnBounds="true" preserveRatio="true">
                    <image>
                        <Image url="@../images/logo.png" />
                    </image>
                </ImageView>
            </children>
        </AnchorPane>
    </left>
    <center>
        <AnchorPane prefHeight="200.0" prefWidth="200.0" style="-fx-background-color: #D3D3D3;" BorderPane.alignment="CENTER">
            <children>
                <Text layoutX="21.0" layoutY="45.0" strokeType="OUTSIDE" strokeWidth="0.0" text="Create Account" wrappingWidth="150.0">
                    <font>
                        <Font name="System Bold" size="18.0" />
                    </font>
                </Text>
                <Text fill="#000000ad" layoutX="23.0" layoutY="65.0" strokeType="OUTSIDE" strokeWidth="0.0" text="Join us to manage your budget" />

                <Text layoutX="125.0" layoutY="95.0" strokeType="OUTSIDE" strokeWidth="0.0" text="Full Name" />
                <TextField fx:id="nameField" layoutX="125.0" layoutY="99.0" promptText="Enter your name" />

                <Text layoutX="125.0" layoutY="145.0" strokeType="OUTSIDE" strokeWidth="0.0" text="Email Address" />
                <TextField fx:id="emailField" layoutX="125.0" layoutY="149.0" promptText="mail@example.com" />

                <Text layoutX="125.0" layoutY="195.0" strokeType="OUTSIDE" strokeWidth="0.0" text="Password" />
                <PasswordField fx:id="passwordField" layoutX="125.0" layoutY="199.0" promptText="Enter Password" />

                <Text layoutX="125.0" layoutY="245.0" strokeType="OUTSIDE" strokeWidth="0.0" text="Confirm Password" />
                <PasswordField fx:id="confirmPasswordField" layoutX="125.0" layoutY="249.0" promptText="Re-enter Password" />

                <Label fx:id="messageLabel" layoutX="125.0" layoutY="280.0" prefWidth="200.0" text="" />

                <Button layoutX="125.0" layoutY="305.0" mnemonicParsing="false" onAction="#handleSignUp" prefHeight="25.0" prefWidth="149.0" style="-fx-background-color: #64D96F;" text="SIGN UP">
                    <font>
                        <Font name="System Bold" size="12.0" />
                    </font>
                </Button>

                <Text layoutX="128.0" layoutY="355.0" strokeType="OUTSIDE" strokeWidth="0.0" text="Already have an account?" />
                <Hyperlink layoutX="175.0" layoutY="360.0" onAction="#goToLogin" text="Log In" underline="true" />
            </children>
        </AnchorPane>
    </center>
</BorderPane>