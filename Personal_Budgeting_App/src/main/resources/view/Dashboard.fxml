<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="650.0" prefWidth="1000.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.DashboardController">

    <!-- 🔹 Sidebar -->
    <left>
        <VBox prefWidth="220" spacing="20" style="-fx-background-color: linear-gradient(to bottom, #42C66B, #169447); -fx-padding: 30;">

            <Label style="-fx-text-fill: white; -fx-font-size: 20px; -fx-font-weight: bold;" text="FINANCIAL GROWTH" wrapText="true" />

            <Button onAction="#openDashboard" prefHeight="40" prefWidth="160" style="-fx-background-color: white; -fx-text-fill: green; -fx-font-weight: bold;" text="Dashboard" />

            <Button onAction="#openReports" prefHeight="40" prefWidth="160" style="-fx-background-color: transparent; -fx-text-fill: white;" text="Reports" />

            <Button onAction="#openNotifications" prefHeight="40" prefWidth="160" style="-fx-background-color: transparent; -fx-text-fill: white;" text="Notifications" />

            <Region VBox.vgrow="ALWAYS" />

            <Button onAction="#logout" prefHeight="40" prefWidth="160" style="-fx-background-color: transparent; -fx-text-fill: white;" text="Logout" />
        </VBox>
    </left>

    <!-- 🔹 Main Content -->
    <center>
        <VBox spacing="22" style="-fx-background-color: #F7F7F7; -fx-padding: 35 45 35 45;">

            <HBox alignment="CENTER_LEFT">
                <Label fx:id="welcomeLabel" text="Hello, John Doe"
                       style="-fx-font-size: 26px;" />
                <Region HBox.hgrow="ALWAYS" />
                <Label text="JD"
                       style="-fx-background-color: #159447; -fx-background-radius: 50; -fx-text-fill: white; -fx-font-size: 20px; -fx-font-weight: bold; -fx-padding: 15;" />
            </HBox>

            <!-- Balance Card -->
            <VBox spacing="18"
                  style="-fx-background-color: linear-gradient(to right, #159447, #42C66B); -fx-background-radius: 18; -fx-padding: 30;">
                <Label text="Total Balance" style="-fx-text-fill: white; -fx-font-size: 20px;" />
                <Label fx:id="balanceLabel" text="\$0.00"
                       style="-fx-text-fill: white; -fx-font-size: 52px; -fx-font-weight: bold;" />

                <HBox spacing="180">
                    <VBox spacing="5">
                        <Label text="↑ Income" style="-fx-text-fill: white; -fx-font-size: 16px;" />
                        <Label fx:id="incomeLabel" text="\$0.00"
                               style="-fx-text-fill: white; -fx-font-size: 24px; -fx-font-weight: bold;" />
                    </VBox>

                    <VBox spacing="5">
                        <Label text="↓ Expenses" style="-fx-text-fill: white; -fx-font-size: 16px;" />
                        <Label fx:id="expenseLabel" text="\$0.00"
                               style="-fx-text-fill: white; -fx-font-size: 24px; -fx-font-weight: bold;" />
                    </VBox>
                </HBox>
            </VBox>

            <!-- Summary Cards -->
            <HBox spacing="25">
                <VBox prefWidth="250" spacing="8"
                      style="-fx-background-color: white; -fx-background-radius: 16; -fx-padding: 22; -fx-border-color: #E5E5E5; -fx-border-radius: 16;">
                    <Label text="Transactions" style="-fx-font-size: 17px; -fx-text-fill: #555;" />
                    <Label fx:id="transactionsCountLabel" text="0"
                           style="-fx-font-size: 30px; -fx-font-weight: bold;" />
                </VBox>

                <VBox prefWidth="250" spacing="8"
                      style="-fx-background-color: white; -fx-background-radius: 16; -fx-padding: 22; -fx-border-color: #E5E5E5; -fx-border-radius: 16;">
                    <Label text="Budgets" style="-fx-font-size: 17px; -fx-text-fill: #555;" />
                    <Label fx:id="budgetsCountLabel" text="0"
                           style="-fx-font-size: 30px; -fx-font-weight: bold; -fx-text-fill: #159447;" />
                </VBox>

                <VBox prefWidth="250" spacing="8"
                      style="-fx-background-color: white; -fx-background-radius: 16; -fx-padding: 22; -fx-border-color: #E5E5E5; -fx-border-radius: 16;">
                    <Label text="Goals" style="-fx-font-size: 17px; -fx-text-fill: #555;" />
                    <Label fx:id="goalsCountLabel" text="0"
                           style="-fx-font-size: 30px; -fx-font-weight: bold; -fx-text-fill: #159447;" />
                </VBox>
            </HBox>

            <!-- Recent Transactions like image -->
            <VBox spacing="15"
                  style="-fx-background-color: white; -fx-padding: 22; -fx-background-radius: 18; -fx-border-color: #E5E5E5; -fx-border-radius: 18;">

                <HBox alignment="CENTER_LEFT">
                    <Label text="Recent Transactions"
                           style="-fx-font-size: 20px; -fx-font-weight: bold;" />
                    <Region HBox.hgrow="ALWAYS" />
                    <Label text="See All"
                           style="-fx-text-fill: #159447; -fx-font-size: 15px; -fx-font-weight: bold;" />
                </HBox>

                <VBox fx:id="recentTransactionsBox" spacing="10" />
            </VBox>

        </VBox>
    </center>

</BorderPane>
