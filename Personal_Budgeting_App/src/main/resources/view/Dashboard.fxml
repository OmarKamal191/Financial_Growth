<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="650.0" prefWidth="1000.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.DashboardController">

    <left>
        <fx:include source="sidebar.fxml" />
    </left>

    <center>
        <VBox spacing="14" style="-fx-background-color: #F7F7F7; -fx-padding: 28 45 28 45;">

            <HBox alignment="CENTER_LEFT">
                <Label fx:id="welcomeLabel" style="-fx-font-size: 25px;" text="Hello, " />

                <Region HBox.hgrow="ALWAYS" />

                <Label fx:id="userIconLabel" alignment="CENTER" prefHeight="58.0" prefWidth="55.0" style="-fx-background-color: #159447; -fx-background-radius: 50; -fx-text-fill: white; -fx-font-size: 13; -fx-font-weight: bold; -fx-padding: 14; -fx-pref-height: 20;" text="U" wrapText="true" />
            </HBox>

            <!-- Balance Card Smaller -->
            <VBox maxHeight="170" prefHeight="170" spacing="10" style="-fx-background-color: linear-gradient(to right, #159447, #42C66B);              -fx-background-radius: 18;              -fx-padding: 18 25 18 25;">

                <Label style="-fx-text-fill: white; -fx-font-size: 16px;" text="Total Balance" />

                <Label fx:id="balanceLabel" style="-fx-text-fill: white; -fx-font-size: 34px; -fx-font-weight: bold;" text="\$0.00" />

                <HBox spacing="130">
                    <VBox spacing="3">
                        <Label style="-fx-text-fill: white; -fx-font-size: 14px;" text="↑ Income" />
                        <Label fx:id="incomeLabel" style="-fx-text-fill: white; -fx-font-size: 18px; -fx-font-weight: bold;" text="\$0.00" />
                    </VBox>

                    <VBox spacing="3">
                        <Label style="-fx-text-fill: white; -fx-font-size: 14px;" text="↓ Expenses" />
                        <Label fx:id="expenseLabel" style="-fx-text-fill: white; -fx-font-size: 18px; -fx-font-weight: bold;" text="\$0.00" />
                    </VBox>
                </HBox>

            </VBox>

            <!-- Summary Cards Smaller -->
            <HBox spacing="25">
                <VBox prefHeight="95" prefWidth="250.0" spacing="5" style="-fx-background-color: white; -fx-background-radius: 16; -fx-padding: 16 22 16 22; -fx-border-color: #E5E5E5; -fx-border-radius: 16;">

                    <Label style="-fx-font-size: 15px; -fx-text-fill: #555;" text="Transactions" />

                    <Label fx:id="transactionsCountLabel" style="-fx-font-size: 25px; -fx-font-weight: bold;" text="0" />
                </VBox>

                <VBox prefHeight="95" prefWidth="250" spacing="5" style="-fx-background-color: white; -fx-background-radius: 16; -fx-padding: 16 22 16 22; -fx-border-color: #E5E5E5; -fx-border-radius: 16;">

                    <Label style="-fx-font-size: 15px; -fx-text-fill: #555;" text="Budgets" />

                    <Label fx:id="budgetsCountLabel" style="-fx-font-size: 25px; -fx-font-weight: bold; -fx-text-fill: #159447;" text="0" />
                </VBox>

                <VBox prefHeight="95" prefWidth="250" spacing="5" style="-fx-background-color: white; -fx-background-radius: 16; -fx-padding: 16 22 16 22; -fx-border-color: #E5E5E5; -fx-border-radius: 16;">

                    <Label style="-fx-font-size: 15px; -fx-text-fill: #555;" text="Goals" />

                    <Label fx:id="goalsCountLabel" style="-fx-font-size: 25px; -fx-font-weight: bold; -fx-text-fill: #159447;" text="0" />
                </VBox>
            </HBox>

            <!-- Recent Transactions Bigger -->
            <VBox prefHeight="300" spacing="15" style="-fx-background-color: white;              -fx-padding: 25 30 25 30;              -fx-background-radius: 18;              -fx-border-color: #E5E5E5;              -fx-border-radius: 18;" VBox.vgrow="ALWAYS">

                <HBox alignment="CENTER_LEFT">
                    <Label style="-fx-font-size: 22px; -fx-font-weight: bold;" text="Recent Transactions" />

                    <Region HBox.hgrow="ALWAYS" />

                    <Button fx:id="seeAllTLabel" mnemonicParsing="false" onAction="#seeAllTransactions" style="-fx-background-color: transparent; -fx-text-fill: #159447; -fx-font-weight: bold;" text="See All" />
                </HBox>

                <VBox fx:id="recentTransactionsBox" spacing="10" VBox.vgrow="ALWAYS" />
            </VBox>

        </VBox>
    </center>

</BorderPane>
