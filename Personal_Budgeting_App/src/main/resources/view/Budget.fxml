<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.Text?>

<BorderPane prefHeight="650.0" prefWidth="1000.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="view.BudgetView">

    <!-- ══ LEFT PANEL: Sidebar ══ -->
    <left>
        <fx:include source="sidebar.fxml" />
    </left>

    <!-- ══ CENTER PANEL ══ -->
    <center>
        <AnchorPane prefHeight="650.0" prefWidth="780.0" style="-fx-background-color: #F7F7F7;" BorderPane.alignment="CENTER">
            <children>

                <!-- ── Page Title ── -->
                <Text layoutX="30.0" layoutY="45.0" strokeType="OUTSIDE" strokeWidth="0.0" text="💰 Budget Manager">
                    <font>
                        <Font name="System Bold" size="22.0" />
                    </font>
                </Text>
                <Text fill="#000000ad" layoutX="32.0" layoutY="68.0" strokeType="OUTSIDE" strokeWidth="0.0" text="Create and track your spending budget" />

                <!-- ════════════════════════════════════
                     CREATE BUDGET FORM (left column)
                ════════════════════════════════════ -->

                <!-- إضافة خانة اختيار الفئة -->
                <Text layoutX="32.0" layoutY="105.0" text="Category">
                    <font>
                        <Font name="System Bold" size="12.0" />
                    </font>
                </Text>
                <ComboBox fx:id="categoryComboBox" layoutX="32.0" layoutY="110.0" prefWidth="200.0" promptText="Select Category" style="-fx-background-radius: 5;" />

                <Text layoutX="32.0" layoutY="155.0" text="Budget Amount">
                    <font>
                        <Font name="System Bold" size="12.0" />
                    </font>
                </Text>
                <TextField fx:id="amountField" layoutX="32.0" layoutY="160.0" prefWidth="200.0" promptText="e.g. 5000" />

                <Text layoutX="32.0" layoutY="205.0" text="Alert Threshold (%)">
                    <font>
                        <Font name="System Bold" size="12.0" />
                    </font>
                </Text>
                <TextField fx:id="thresholdField" layoutX="32.0" layoutY="210.0" prefWidth="200.0" promptText="e.g. 80" />

                <Text layoutX="32.0" layoutY="255.0" text="Start Date">
                    <font>
                        <Font name="System Bold" size="12.0" />
                    </font>
                </Text>
                <DatePicker fx:id="startDatePicker" layoutX="32.0" layoutY="260.0" prefWidth="200.0" />

                <Text layoutX="32.0" layoutY="307.0" text="End Date">
                    <font>
                        <Font name="System Bold" size="12.0" />
                    </font>
                </Text>
                <DatePicker fx:id="endDatePicker" layoutX="32.0" layoutY="312.0" prefWidth="200.0" />

                <Label fx:id="statusLabel" layoutX="32.0" layoutY="350.0" prefWidth="200.0" wrapText="true" />

                <Button layoutX="32.0" layoutY="385.0" mnemonicParsing="false" onAction="#handleCreateBudget" prefHeight="35.0" prefWidth="200.0" style="-fx-background-color: #159447; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 8;" text="CREATE BUDGET">
                    <font>
                        <Font name="System Bold" size="13.0" />
                    </font>
                </Button>

                <Button layoutX="32.0" layoutY="430.0" mnemonicParsing="false" onAction="#handleDeleteBudget" prefHeight="30.0" prefWidth="200.0" style="-fx-background-color: #E05C5C; -fx-text-fill: white; -fx-background-radius: 8;" text="DELETE SELECTED">
                    <font>
                        <Font name="System Bold" size="12.0" />
                    </font>
                </Button>

                <!-- ════════════════════════════════════
                     ACTIVE BUDGET INFO (right column)
                ════════════════════════════════════ -->
                <Text layoutX="265.0" layoutY="105.0" text="Active Budget">
                    <font>
                        <Font name="System Bold" size="16.0" />
                    </font>
                </Text>

                <Label fx:id="totalBudgetLabel" layoutX="265.0" layoutY="122.0" prefWidth="480.0" text="Total Budget: —">
                    <font>
                        <Font size="14.0" />
                    </font>
                </Label>

                <Label fx:id="spentLabel" layoutX="265.0" layoutY="148.0" prefWidth="480.0" text="Spent: —">
                    <font>
                        <Font size="14.0" />
                    </font>
                </Label>

                <Label fx:id="remainingLabel" layoutX="265.0" layoutY="174.0" prefWidth="480.0" text="Remaining: —">
                    <font>
                        <Font size="14.0" />
                    </font>
                </Label>

                <Label fx:id="periodLabel" layoutX="265.0" layoutY="200.0" prefWidth="480.0" text="Period: —">
                    <font>
                        <Font size="13.0" />
                    </font>
                </Label>

                <Label fx:id="percentLabel" layoutX="265.0" layoutY="226.0" prefWidth="200.0" text="0.0% used">
                    <font>
                        <Font size="13.0" />
                    </font>
                </Label>

                <ProgressBar fx:id="budgetProgressBar" layoutX="265.0" layoutY="248.0" prefHeight="20.0" prefWidth="480.0" progress="0.0" />

                <!-- ── All Budgets Table ── -->
                <Text layoutX="265.0" layoutY="290.0" text="All Budgets">
                    <font>
                        <Font name="System Bold" size="14.0" />
                    </font>
                </Text>

                <TableView fx:id="budgetTable" layoutX="265.0" layoutY="300.0" prefHeight="320.0" prefWidth="480.0">
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                    </columnResizePolicy>
                    <columns>
                        <TableColumn fx:id="colCategory" text="Category" />
                        <TableColumn fx:id="colAmount" text="Amount" />
                        <TableColumn fx:id="colSpent" text="Spent" />
                        <TableColumn fx:id="colRemaining" text="Remaining" />
                        <TableColumn fx:id="colStart" text="Start Date" />
                        <TableColumn fx:id="colEnd" text="End Date" />
                    </columns>
                </TableView>

            </children>
        </AnchorPane>
    </center>

</BorderPane>