<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.Text?>

<BorderPane prefHeight="650.0" prefWidth="1000.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="view.ProfileView">

    <!-- ══ LEFT PANEL: Sidebar ══ -->
    <left>
        <fx:include source="sidebar.fxml"/>
    </left>

    <!-- ══ CENTER PANEL ══ -->
    <center>
        <AnchorPane prefHeight="650.0" prefWidth="780.0" style="-fx-background-color: #F7F7F7;" BorderPane.alignment="CENTER">
            <children>

                <!-- ── Page Title ── -->
                <Text layoutX="30.0" layoutY="45.0" strokeType="OUTSIDE" strokeWidth="0.0" text="👤 User Profile">
                    <font><Font name="System Bold" size="22.0" /></font>
                </Text>
                <Text fill="#000000ad" layoutX="32.0" layoutY="68.0" strokeType="OUTSIDE" strokeWidth="0.0" text="View and manage your account information" />

                <!-- ── Profile Card ── -->
                <VBox layoutX="50.0" layoutY="110.0" spacing="30.0"
                      style="-fx-background-color: white; -fx-background-radius: 16; -fx-padding: 35 40 35 40; -fx-border-color: #E5E5E5; -fx-border-radius: 16;"
                      prefWidth="500.0">
                    <children>

                        <VBox spacing="5.0">
                            <Label style="-fx-text-fill: #888; -fx-font-size: 13px;" text="Full Name" />
                            <Label fx:id="nameLabel" style="-fx-font-size: 20px; -fx-font-weight: bold;" text="Loading..." />
                        </VBox>

                        <VBox spacing="5.0">
                            <Label style="-fx-text-fill: #888; -fx-font-size: 13px;" text="Email Address" />
                            <Label fx:id="emailLabel" style="-fx-font-size: 20px; -fx-font-weight: bold;" text="Loading..." />
                        </VBox>

                        <Button mnemonicParsing="false" onAction="#goToUpdateProfile"
                                prefHeight="42.0" prefWidth="200.0"
                                style="-fx-background-color: #159447; -fx-text-fill: white; -fx-background-radius: 8;" text="EDIT PROFILE">
                            <font><Font name="System Bold" size="14.0" /></font>
                        </Button>

                    </children>
                </VBox>

            </children>
        </AnchorPane>
    </center>

</BorderPane>