<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.Text?>

<BorderPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.devTeamController">
    <left>
        <AnchorPane prefHeight="400.0" prefWidth="180.0" style="-fx-background-color: #64D96F;" BorderPane.alignment="CENTER">
            <children>
                <ImageView fitHeight="400.0" fitWidth="205.0" pickOnBounds="true" preserveRatio="true">
                    <image>
                        <Image url="@../images/logo.png" />
                    </image>
                </ImageView>
            </children>
        </AnchorPane>
    </left>
    <center>
        <AnchorPane prefHeight="400.0" prefWidth="420.0" style="-fx-background-color: #D3D3D3;" BorderPane.alignment="CENTER">
            <children>
                <Text layoutX="25.0" layoutY="45.0" strokeType="OUTSIDE" strokeWidth="0.0" text="Development Team">
                    <font>
                        <Font name="System Bold" size="22.0" />
                    </font>
                </Text>

                <VBox layoutX="100.0" layoutY="80.0" spacing="15.0">
                    <children>
                        <Text style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-fill: #169447;" text="• Omar Ahmed" />
                        <Text style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-fill: #169447;" text="• Yousef Ahmed" />
                        <Text style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-fill: #169447;" text="• Farouk Mohamed" />
                        <Text style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-fill: #169447;" text="• Kerolos George" />
                    </children>
                </VBox>

                <VBox layoutX="125.0" layoutY="280.0" spacing="10.0" alignment="CENTER">
                    <children>
                        <Button mnemonicParsing="false" onAction="#goToLogin" prefHeight="35.0" prefWidth="150.0" style="-fx-background-color: #64D96F;" text="GO TO LOGIN">
                            <font>
                                <Font name="System Bold" size="12.0" />
                            </font>
                        </Button>
                        <Button mnemonicParsing="false" onAction="#goToRegister" prefHeight="35.0" prefWidth="150.0" style="-fx-background-color: white; -fx-text-fill: #169447; -fx-border-color: #64D96F;" text="REGISTER NOW">
                            <font>
                                <Font name="System Bold" size="12.0" />
                            </font>
                        </Button>
                    </children>
                </VBox>
            </children>
        </AnchorPane>
    </center>
</BorderPane>