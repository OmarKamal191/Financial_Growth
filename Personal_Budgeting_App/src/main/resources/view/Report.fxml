<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.chart.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane prefHeight="650.0" prefWidth="1000.0"
            xmlns="http://javafx.com/javafx/26"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controller.ReportController">

    <left>
        <fx:include source="sidebar.fxml"/>
    </left>

    <center>
        <VBox spacing="18"
              style="-fx-background-color: #F7F7F7; -fx-padding: 30 45 30 45;">

            <Label text="Reports"
                   style="-fx-font-size: 28px; -fx-font-weight: bold;" />

            <HBox spacing="20">

                <VBox prefWidth="430" prefHeight="260"
                      style="-fx-background-color: white; -fx-background-radius: 18; -fx-padding: 20;">
                    <Label text="Expenses by Category"
                           style="-fx-font-size: 18px; -fx-font-weight: bold;" />

                    <PieChart fx:id="expensePieChart"
                              prefHeight="210"
                              legendVisible="true"
                              labelsVisible="true" />
                </VBox>

                <VBox prefWidth="350" prefHeight="260"
                      style="-fx-background-color: white; -fx-background-radius: 18; -fx-padding: 20;">
                    <Label text="Summary Insight"
                           style="-fx-font-size: 18px; -fx-font-weight: bold;" />

                    <Label fx:id="insightLabel"
                           wrapText="true"
                           style="-fx-background-color: #EEF7FF; -fx-background-radius: 12; -fx-padding: 16; -fx-font-size: 15px; -fx-text-fill: #333;" />
                </VBox>

            </HBox>

            <VBox prefHeight="300"
                  style="-fx-background-color: white; -fx-background-radius: 18; -fx-padding: 20;">

                <Label text="Income vs Expenses"
                       style="-fx-font-size: 18px; -fx-font-weight: bold;" />

                <BarChart fx:id="incomeExpenseBarChart"
                          prefHeight="250"
                          legendVisible="true"
                          animated="false">
                    <xAxis>
                        <CategoryAxis fx:id="monthAxis" />
                    </xAxis>
                    <yAxis>
                        <NumberAxis fx:id="amountAxis" />
                    </yAxis>
                </BarChart>

            </VBox>

        </VBox>
    </center>

</BorderPane>