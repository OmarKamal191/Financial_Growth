<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.Text?>

<BorderPane prefHeight="650.0" prefWidth="1000.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="view.GoalView">

    <!-- ══ LEFT PANEL: Sidebar ══ -->
    <left>
        <fx:include source="sidebar.fxml"/>
    </left>

    <!-- ══ CENTER PANEL ══ -->
    <center>
        <AnchorPane prefHeight="650.0" prefWidth="780.0" style="-fx-background-color: #F7F7F7;" BorderPane.alignment="CENTER">
            <children>

                <!-- ── Page Title ── -->
                <Text layoutX="30.0" layoutY="45.0" strokeType="OUTSIDE" strokeWidth="0.0" text="🎯 Financial Goals">
                    <font><Font name="System Bold" size="22.0" /></font>
                </Text>
                <Text fill="#000000ad" layoutX="32.0" layoutY="68.0" strokeType="OUTSIDE" strokeWidth="0.0" text="Set saving targets and track your progress" />

                <!-- ════════════════════════════════════
                     CREATE GOAL FORM (left column)
                ════════════════════════════════════ -->
                <Text layoutX="32.0" layoutY="105.0" text="Goal Name">
                    <font><Font name="System Bold" size="12.0" /></font>
                </Text>
                <TextField fx:id="goalNameField" layoutX="32.0" layoutY="110.0" prefWidth="200.0" promptText="e.g. New Laptop" />

                <Text layoutX="32.0" layoutY="150.0" text="Target Amount">
                    <font><Font name="System Bold" size="12.0" /></font>
                </Text>
                <TextField fx:id="targetAmountField" layoutX="32.0" layoutY="155.0" prefWidth="200.0" promptText="e.g. 10000" />

                <Text layoutX="32.0" layoutY="195.0" text="Deadline">
                    <font><Font name="System Bold" size="12.0" /></font>
                </Text>
                <DatePicker fx:id="deadlinePicker" layoutX="32.0" layoutY="200.0" prefWidth="200.0" />

                <Label fx:id="statusLabel" layoutX="32.0" layoutY="242.0" prefWidth="200.0" wrapText="true" />

                <Button layoutX="32.0" layoutY="268.0" mnemonicParsing="false" onAction="#handleCreateGoal" prefHeight="35.0" prefWidth="200.0" style="-fx-background-color: #159447; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 8;" text="CREATE GOAL">
                    <font><Font name="System Bold" size="13.0" /></font>
                </Button>

                <!-- ── Update Progress ── -->
                <Text layoutX="32.0" layoutY="325.0" text="Update Progress">
                    <font><Font name="System Bold" size="12.0" /></font>
                </Text>
                <TextField fx:id="addAmountField" layoutX="32.0" layoutY="333.0" prefWidth="140.0" promptText="Add amount" />
                <Button layoutX="178.0" layoutY="333.0" mnemonicParsing="false" onAction="#handleUpdateProgress" prefHeight="27.0" prefWidth="54.0" style="-fx-background-color: #5B9BD5; -fx-text-fill: white; -fx-background-radius: 8;" text="+ Add">
                    <font><Font name="System Bold" size="11.0" /></font>
                </Button>

                <!-- ── State Buttons ── -->
                <Button fx:id="pauseResumeBtn" layoutX="32.0" layoutY="372.0" mnemonicParsing="false" onAction="#handlePauseResume" prefHeight="28.0" prefWidth="95.0" style="-fx-background-color: #FAB387; -fx-text-fill: white; -fx-background-radius: 8;" text="PAUSE">
                    <font><Font name="System Bold" size="11.0" /></font>
                </Button>
                <Button layoutX="133.0" layoutY="372.0" mnemonicParsing="false" onAction="#handleCancelGoal" prefHeight="28.0" prefWidth="99.0" style="-fx-background-color: #E05C5C; -fx-text-fill: white; -fx-background-radius: 8;" text="CANCEL">
                    <font><Font name="System Bold" size="11.0" /></font>
                </Button>

                <Button layoutX="32.0" layoutY="410.0" mnemonicParsing="false" onAction="#handleDeleteGoal" prefHeight="28.0" prefWidth="200.0" style="-fx-background-color: #888; -fx-text-fill: white; -fx-background-radius: 8;" text="DELETE SELECTED">
                    <font><Font name="System Bold" size="11.0" /></font>
                </Button>

                <!-- ════════════════════════════════════
                     GOALS TABLE (right column)
                ════════════════════════════════════ -->
                <Text layoutX="265.0" layoutY="105.0" text="Your Goals">
                    <font><Font name="System Bold" size="16.0" /></font>
                </Text>

                <TableView fx:id="goalsTable" layoutX="265.0" layoutY="115.0" prefHeight="340.0" prefWidth="490.0">
                    <columns>
                        <TableColumn fx:id="colGoalName" prefWidth="130" text="Goal" />
                        <TableColumn fx:id="colTarget" prefWidth="90" text="Target" />
                        <TableColumn fx:id="colSaved" prefWidth="90" text="Saved" />
                        <TableColumn fx:id="colGoalStatus" prefWidth="120" text="Status" />
                        <TableColumn fx:id="colDeadline" prefWidth="60" text="Deadline" />
                    </columns>
                </TableView>

                <!-- ── Progress Bar for selected goal ── -->
                <Text layoutX="265.0" layoutY="472.0" text="Selected Goal Progress">
                    <font><Font name="System Bold" size="13.0" /></font>
                </Text>

                <ProgressBar fx:id="goalProgressBar" layoutX="265.0" layoutY="482.0" prefHeight="22.0" prefWidth="490.0" progress="0.0" />

                <Label fx:id="progressLabel" layoutX="265.0" layoutY="512.0" prefWidth="490.0" text="Select a goal to see progress">
                    <font><Font size="13.0" /></font>
                </Label>

            </children>
        </AnchorPane>
    </center>

</BorderPane>